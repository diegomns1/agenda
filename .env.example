# Copie para .env.local e preencha.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=SUA_ANON_KEY
# Só no servidor (cron, push). NUNCA expor no cliente.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do app (usada em links de e-mail e no wa.me)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WhatsApp do suporte (só dígitos com DDI). Aparece na tela "aguardando aprovação".
NEXT_PUBLIC_SUPORTE_WHATSAPP=

# Web Push (módulo 6) — gerar com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu@email.com

# Segredo que o pg_cron envia no header Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# E-mails do app (etapa 4) via Resend (https://resend.com). Sem estas duas, nenhum e-mail é enviado
# e o app funciona normalmente. O domínio do remetente precisa estar verificado no Resend.
RESEND_API_KEY=
EMAIL_REMETENTE="Vaguinha <contato@vaguinha.app>"
# Quem recebe o aviso "novo cadastro aguardando aprovação" (opcional)
EMAIL_ADMIN=
# Contato que aparece nos Termos, na Privacidade e no rodapé dos e-mails
NEXT_PUBLIC_EMAIL_CONTATO=contato@vaguinha.app
# Nome de quem opera o serviço (aparece nos Termos)
NEXT_PUBLIC_OPERADOR=DIGSTUDIO

# Cobrança (etapa 5) via Asaas (https://www.asaas.com). Sem ASAAS_API_KEY a página Assinatura mostra
# "pagamento online em breve" e a liberação continua manual pelo Admin.
ASAAS_API_KEY=
# sandbox (testes, sem dinheiro de verdade) | producao
ASAAS_AMBIENTE=sandbox
# Token que você escolhe ao cadastrar o webhook no Asaas (header asaas-access-token). Qualquer texto longo e secreto.
ASAAS_WEBHOOK_TOKEN=

# Assistente no WhatsApp (API oficial da Meta). Sem WHATSAPP_TOKEN as respostas só aparecem no log.
# Número da Vaguinha, só dígitos com 55 (liga o quadro "Assistente no WhatsApp" no Perfil)
NEXT_PUBLIC_WHATSAPP_ASSISTENTE=
# ID do número (Meta → WhatsApp → Configuração da API). Não é segredo.
WHATSAPP_PHONE_NUMBER_ID=
# Chave permanente do usuário do sistema (SEGREDO)
WHATSAPP_TOKEN=
# Chave secreta do app (Configurações do app → Básico) — confere que o aviso veio da Meta (SEGREDO)
WHATSAPP_APP_SECRET=
# Senha que você escolhe ao cadastrar o webhook na Meta (SEGREDO)
WHATSAPP_VERIFY_TOKEN=
# Opcional: versão da API da Meta
WHATSAPP_GRAPH_VERSION=v23.0
